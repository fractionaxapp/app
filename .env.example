# Absolute origin the site is served from, e.g. https://example.com.
# Used for canonical URLs, Open Graph images, robots.txt and the sitemap.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave unset to disable analytics: no gtag.js is loaded and every
# trackEvent() call becomes a no-op. Outside production the tag runs in
# GA debug mode so events show up in DebugView.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token. Emits the
# google-site-verification meta tag only when set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
