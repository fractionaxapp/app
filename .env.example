# Privy app credentials, from the Privy dashboard.
# Leave NEXT_PUBLIC_PRIVY_APP_ID unset to disable auth entirely: no provider
# mounts and the app renders as an anonymous marketing site.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Server-side only — never expose. Used to verify access tokens and to
# authenticate webhook calls.
PRIVY_APP_SECRET=

# Postgres on the DigitalOcean droplet.
# postgres://USER:PASSWORD@HOST:5432/DATABASE
# Required by `npm run db:migrate` and by anything that reads lib/db.
DATABASE_URL=

# Set to "true" once Postgres is serving TLS. Leave unset for a stock droplet
# install reached over a private network or SSH tunnel.
DATABASE_SSL=
# Set to "true" only when the certificate chain is verifiable (not self-signed).
DATABASE_SSL_STRICT=
# Connections this app may hold. Keep well under Postgres max_connections.
DATABASE_POOL_MAX=

# Who may admit other people to the private beta. Comma-separated, and empty by
# default: with neither set there are no administrators and /dashboard/admin
# answers 404 to everyone, including you.
#
# Match on either. Emails are easier to set before anyone has signed in; DIDs
# are stable if an address changes. A DID is the "Account ID" on the profile
# screen, or: SELECT privy_did, email FROM users;
ADMIN_EMAILS=
ADMIN_PRIVY_DIDS=

# Notification email for landing-page questions, through Resend. Leave unset to
# skip sending: questions are still recorded and still appear on the admin
# enquiries screen, which says so plainly when this is not configured.
#
# CONTACT_FROM_EMAIL must be on a domain verified in Resend. CONTACT_TO_EMAIL
# may list several addresses, comma-separated.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Reading mandates and offerings with the model. Leave unset and the built-in
# parser reads mandates instead, and fields a venue only states in prose stay
# null — shown to the investor as unverifiable rather than guessed at.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5. Every call is a bounded extraction from text.
ANTHROPIC_MODEL=

# Shared secret for POST /api/cron/crawl. Unset means the endpoint refuses
# outright: an open crawl trigger lets anyone make this server hammer another.
CRON_SECRET=

# Absolute origin the site is served from. In production this is
# https://fractionax.app — set it, or canonical URLs, Open Graph images,
# robots.txt and the sitemap all point at localhost.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave unset to disable analytics: no gtag.js is loaded and every
# trackEvent() call becomes a no-op. Outside production the tag runs in
# GA debug mode so events show up in DebugView.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token. Emits the
# google-site-verification meta tag only when set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
